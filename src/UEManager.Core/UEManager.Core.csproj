<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>UEManager.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ZIP, 7z and RAR extraction in managed code. MIT licensed. -->
    <PackageReference Include="SharpCompress" Version="0.50.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every game profile is built into the assembly; GameProfile.BuiltIn() reads them. One app serves all
         games: the player chooses one, and the app starts with it (see Games\GameChoice.cs). -->
    <None Remove="Games\Profiles\*.json" />
    <EmbeddedResource Include="Games\Profiles\*.json" LogicalName="UEManager.Core.Games.Profiles.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The known lines of UE4SS.log and UE4SS's own mods; Ue4ssLogRules reads it. -->
    <None Remove="Mods\Ue4ssLog.json" />
    <EmbeddedResource Include="Mods\Ue4ssLog.json" LogicalName="UEManager.Core.Mods.Ue4ssLog.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UEManager.Core.Tests" />
  </ItemGroup>

</Project>
