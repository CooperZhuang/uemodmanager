<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The command line tool over UEManager.Core, built into the app's exe and started by its cli switch (see
         CommandLine.Switch). No WPF, no UI, no third-party package. A library, so the release stays one exe: the
         self-update takes exactly one. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>UEManager.Cli</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UEManager.Cli.Tests" />
    <ProjectReference Include="..\UEManager.Core\UEManager.Core.csproj" />
  </ItemGroup>

</Project>
