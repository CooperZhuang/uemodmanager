<UserControl x:Class="UEManager.UI.Views.ModDetailsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             xmlns:views="clr-namespace:UEManager.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ModDetailsViewModel}">
    <Border Style="{StaticResource Dialog}" Width="820">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Mod details', Tracked=True}" />
            <DockPanel Margin="0,8,0,0" Visibility="{Binding IsShowing, Converter={StaticResource Visible}}">
                <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Button.StatusBox}"
                        Command="{Binding RenameCommand}" ToolTip="{ui:Loc 'Change the name, version or tags'}"
                        Foreground="{StaticResource Brush.Edit}" BorderBrush="{StaticResource Brush.Edit}" Background="{StaticResource Brush.EditWash}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="{ui:Loc 'Edit'}" />
                        <TextBlock Margin="8,0,0,0" Style="{StaticResource Text.Icon}" FontSize="12" Text="&#xE70F;" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Button.StatusBox}"
                        Command="{Binding AddTagCommand}" Visibility="{Binding CanTag, Converter={StaticResource Visible}}"
                        Foreground="{StaticResource Brush.Edit}" BorderBrush="{StaticResource Brush.Edit}" Background="{StaticResource Brush.EditWash}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="{ui:Loc 'Add tag'}" />
                        <TextBlock Margin="8,0,0,0" Style="{StaticResource Text.Icon}" FontSize="12" Text="&#xE8EC;" />
                    </StackPanel>
                </Button>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Title}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
            </DockPanel>
            <TextBlock Margin="0,6,0,16" Style="{StaticResource Text.Body}" Text="{Binding Summary}"
                       Visibility="{Binding IsShowing, Converter={StaticResource Visible}}" />

            <!-- Rename: the name and version as the install review has them, and the tags; Enter saves, Esc cancels. -->
            <Grid Margin="0,10,0,16" Visibility="{Binding IsRenaming, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Name', Tracked=True}" />
                    <TextBox x:Name="NameBox" Margin="0,6,0,0" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SaveRenameCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Version', Tracked=True}" />
                    <TextBox Margin="0,6,0,0" Text="{Binding NewVersion, UpdateSourceTrigger=PropertyChanged}" Tag="{ui:Loc 'Optional'}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SaveRenameCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Visibility="{Binding CanTag, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Tags', Tracked=True}" />
                    <TextBox x:Name="TagsBox" Margin="0,6,0,0" Text="{Binding NewTags, UpdateSourceTrigger=PropertyChanged}" Tag="{ui:Loc 'Separate with commas, such as Combat, UI'}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SaveRenameCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                        <Setter Property="Margin" Value="0,4,16,4" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </Grid.Resources>

                <TextBlock Text="{ui:Loc 'Installed on', Tracked=True}" />
                <TextBlock Grid.Column="1" Margin="0,4" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Text="{Binding InstalledText}" />

                <TextBlock Grid.Row="1" Text="{ui:Loc 'Installed from', Tracked=True}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" Style="{StaticResource Text.Path}" Text="{Binding SourceText}" />

                <TextBlock Grid.Row="2" Text="{ui:Loc 'Catalog id', Tracked=True}" Visibility="{Binding CatalogId, Converter={StaticResource VisibleIfSet}}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" Style="{StaticResource Text.Path}" Text="{Binding CatalogId}"
                           Visibility="{Binding CatalogId, Converter={StaticResource VisibleIfSet}}" />

                <TextBlock Grid.Row="3" Text="{ui:Loc 'Size', Tracked=True}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Text="{Binding SizeText}" />

                <TextBlock Grid.Row="4" Text="{ui:Loc 'Tags', Tracked=True}" Visibility="{Binding TagsText, Converter={StaticResource VisibleIfSet}}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Info}" Text="{Binding TagsText}"
                           Visibility="{Binding TagsText, Converter={StaticResource VisibleIfSet}}" />
            </Grid>

            <!-- Files changed outside the manager stop a disable, an update and an uninstall, until the player keeps them. -->
            <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="2" BorderThickness="1"
                    BorderBrush="{StaticResource Brush.Warning}" Background="{StaticResource Brush.WarningWash}"
                    Visibility="{Binding HasChangedFiles, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Content="{ui:Loc 'Keep my version'}"
                            ui:Icon.Glyph="&#xE73E;" Command="{Binding KeepChangedFilesCommand}"
                            ToolTip="{ui:Loc 'From then on the manager treats your version like a settings file: it keeps it when the mod is turned off, asks about it on an update and backs it up on an uninstall. Reset settings brings back the mod\'s own version.'}" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                               TextWrapping="Wrap" TextTrimming="None" Text="{Binding ChangedText}" />
                </DockPanel>
            </Border>

            <TextBlock Margin="0,14,0,6" Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Files in the game', Tracked=True}" />
            <views:FileTree MaxHeight="360" DataContext="{Binding Rows}" />

            <Grid Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsShowing, Converter={StaticResource Visible}}">
                    <Button Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Close'}" Command="{Binding CloseCommand}" IsCancel="True" />
                </StackPanel>
                <!-- While renaming, in place of Close; Esc cancels the rename, not the window. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsRenaming, Converter={StaticResource Visible}}">
                    <Button Content="{ui:Loc 'Cancel'}" Command="{Binding CancelRenameCommand}" IsCancel="True" />
                    <Button Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Save'}" ui:Icon.Glyph="&#xE74E;"
                            Command="{Binding SaveRenameCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
