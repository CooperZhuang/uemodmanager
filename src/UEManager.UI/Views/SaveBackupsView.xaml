<UserControl x:Class="UEManager.UI.Views.SaveBackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Field" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- The arrows to the other column: larger and bolder than the usual icons, so they read at a glance. -->
        <TextBlock x:Key="BackupArrowRight" x:Shared="False" Style="{StaticResource Text.Icon}" FontSize="17" FontWeight="Bold" Text="&#xE72A;" />
        <TextBlock x:Key="BackupArrowLeft" x:Shared="False" Style="{StaticResource Text.Icon}" FontSize="17" FontWeight="Bold" Text="&#xE72B;" />

        <!-- One backup: when it was made and its size, Restore and Delete, an arrow to the other column, and the
             player's note below, saved on Enter or when the field loses the focus. The arrow points where the backup
             goes: a green one at the right end of a normal backup, towards Personal; a red one at the left end of a
             personal backup, back towards Normal. -->
        <DataTemplate x:Key="BackupRow" DataType="{x:Type vm:SaveBackupItem}">
            <Border Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Line}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Margin="0,0,8,0" Style="{StaticResource Button.Icon}"
                                Content="{StaticResource BackupArrowLeft}" Foreground="{StaticResource Brush.Danger}"
                                ToolTip="{ui:Loc 'Move it back to Normal, where the oldest are removed'}"
                                AutomationProperties.Name="{ui:Loc 'Move it back to Normal, where the oldest are removed'}"
                                Visibility="{Binding IsPersonal, Converter={StaticResource Visible}}"
                                Command="{Binding DataContext.ReleaseSaveBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Path}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{ui:Loc 'Restore…'}" ui:Icon.Glyph="&#xE777;"
                                    Command="{Binding DataContext.RestoreSaveBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Path}" />
                            <Button Margin="6,0,0,0" Style="{StaticResource Button.IconDanger}" ui:Icon.Glyph="&#xE74D;"
                                    ToolTip="{ui:Loc 'Delete save backup'}" AutomationProperties.Name="{ui:Loc 'Delete save backup'}"
                                    Command="{Binding DataContext.DeleteSaveBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Path}" />
                            <Button Margin="6,0,0,0" Style="{StaticResource Button.Icon}"
                                    Content="{StaticResource BackupArrowRight}" Foreground="{StaticResource Brush.Success}"
                                    ToolTip="{ui:Loc 'Keep for good: move it to Personal, where the app never removes it'}"
                                    AutomationProperties.Name="{ui:Loc 'Keep'}"
                                    Visibility="{Binding IsPersonal, Converter={StaticResource Hidden}}"
                                    Command="{Binding DataContext.KeepSaveBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Path}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                                   Text="{Binding Text}" ToolTip="{Binding Path}" />
                    </DockPanel>
                    <TextBox Margin="0,8,0,0" MaxLength="80" Text="{Binding Note, UpdateSourceTrigger=LostFocus}"
                             Tag="{ui:Loc 'Add a note…'}" KeyDown="OnNoteKeyDown"
                             AutomationProperties.Name="{ui:Loc 'Add a note…'}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Your saves', Tracked=True}" />
            <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Display}" Text="{ui:Loc 'Save backups'}" />
            <Rectangle Width="200" Height="2" Margin="0,14,0,0" HorizontalAlignment="Left" Fill="{StaticResource Brush.Stroke}" />
            <!-- Off until the game profile names the save folder. -->
            <TextBlock Margin="0,14,0,0" MaxWidth="640" HorizontalAlignment="Left" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Warning}" Text="{Binding SaveBackupsHint}"
                       Visibility="{Binding SaveBackupsHint, Converter={StaticResource VisibleIfSet}}" />
        </StackPanel>

        <!-- Where the saves are, how many normal backups stay, and a backup now. -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}" IsEnabled="{Binding SaveBackupsAvailable}">
            <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Save folder', Tracked=True}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Path}" Text="{Binding SaveFolderText}" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                                   Foreground="{Binding SaveFolderTone, Converter={StaticResource Tone}}" Text="{Binding SaveFolderDetail}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Backups to keep', Tracked=True}" />
                    <!-- 2 to 20 in steps of 2, saved at once; the number shows next to it. -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="300" VerticalAlignment="Center" Minimum="{Binding SaveBackupKeepMin}" Maximum="{Binding SaveBackupKeepMax}"
                                    TickFrequency="{Binding SaveBackupKeepStep}" SmallChange="{Binding SaveBackupKeepStep}"
                                    LargeChange="{Binding SaveBackupKeepStep}" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                    Value="{Binding SaveBackupKeep}" AutomationProperties.Name="{ui:Loc 'Backups to keep'}" />
                            <TextBlock Margin="14,0,0,0" MinWidth="20" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text}" Text="{Binding SaveBackupKeep}" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                                   Text="{ui:Loc 'Older backups are removed after the next successful backup.'}" />
                    </StackPanel>
                </DockPanel>
                <CheckBox Margin="0,4,0,16" Content="{ui:Loc 'Back up my saves each time I start the game here'}"
                          IsChecked="{Binding BackUpSavesOnLaunch}" />
                <!-- A backup now, with an optional note, and the folders right after it; one row that wraps only when it must. -->
                <WrapPanel Margin="0,0,0,-6">
                    <TextBox Width="240" Margin="0,0,8,6" MaxLength="80" VerticalAlignment="Center"
                             Text="{Binding NewSaveBackupNote, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{ui:Loc 'Note for the new backup (optional)'}"
                             AutomationProperties.Name="{ui:Loc 'Note for the new backup (optional)'}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding BackUpSavesNowCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Margin="0,0,8,6" Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Back up now'}"
                            ui:Icon.Glyph="&#xE896;" Command="{Binding BackUpSavesNowCommand}" />
                    <Button Margin="0,0,8,6" Content="{ui:Loc 'Choose save folder…'}" ui:Icon.Glyph="&#xE838;" Command="{Binding ChooseSaveFolderCommand}" />
                    <Button Margin="0,0,8,6" Content="{ui:Loc 'Open save folder'}" Command="{Binding OpenSaveFolderCommand}" />
                    <Button Margin="0,0,0,6" Content="{ui:Loc 'Open save backups'}" ui:Icon.Glyph="&#xE81C;" Command="{Binding OpenSaveBackupsCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Normal on the left, the oldest go; Personal on the right, kept for good and not counted. -->
        <Grid Margin="0,20,0,0" IsEnabled="{Binding SaveBackupsAvailable}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc 'Normal'}" />
                    <TextBlock Margin="0,6,0,6" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Text="{Binding SaveBackupsText}" />
                    <ItemsControl ItemsSource="{Binding SaveBackupList}" ItemTemplate="{StaticResource BackupRow}" Focusable="False" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc 'Personal'}" />
                    <TextBlock Margin="0,6,0,6" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                               Text="{ui:Loc 'Kept for good: the app never removes them, and they do not count.'}" />
                    <ItemsControl ItemsSource="{Binding PersonalSaveBackupList}" ItemTemplate="{StaticResource BackupRow}" Focusable="False" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                               Text="{ui:Loc 'None yet. Keep a backup to move it here.'}"
                               Visibility="{Binding HasPersonalSaveBackups, Converter={StaticResource Hidden}}" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
