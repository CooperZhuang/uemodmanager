<UserControl x:Class="UEManager.UI.Views.FileTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels">
    <!-- Files in the tree of their folders in the game, each with its size and state; the DataContext is the rows.
         The mod details show a mod's files, the install review the files of the parts that are ticked. -->
    <Border Padding="14,8" CornerRadius="2" BorderThickness="1"
            Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Line}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding}" Focusable="False" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModTreeRow}">
                        <Grid Margin="0,3">
                            <!-- Size and state line up across rows; a state the review leaves empty gives its room to the name. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="State" MaxWidth="220" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Margin="0,0,12,0">
                                <Rectangle DockPanel.Dock="Left" Width="{Binding Indent}" />
                                <TextBlock x:Name="Icon" DockPanel.Dock="Left" Margin="0,0,8,0" Style="{StaticResource Text.Icon}" FontSize="12"
                                           Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Glyph}" />
                                <TextBlock x:Name="Label" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                           Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis"
                                           Text="{Binding Name}" ToolTip="{Binding File.FullPath}" />
                            </DockPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding File.Size}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                                       Foreground="{Binding File.Tone, Converter={StaticResource Tone}}" Text="{Binding File.State}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
