<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Stellar Blade: Blood Rain, "Porcelain 2": neutral graphite-blue surfaces, porcelain-white text and a powder-blue
         accent, after the white suit and mechanical gauntlet of the art. Chosen on 2026-11-11 in place of the first teal
         slate: the Porcelain blue idea, one step (0.035 in OKLCH lightness) darker. The accent is light, so text on it is
         dark. background.jpg has its sky tinted to match. A key that is left out keeps the shared value. A brush here
         must name its colour again: the brushes of Palette.xaml keep that file's colours. -->
    <Color x:Key="Color.Ink">#1F2225</Color>
    <Color x:Key="Color.InkClear">#001F2225</Color>
    <Color x:Key="Color.Accent">#8EB9E8</Color>
    <Color x:Key="Color.AccentBright">#BAD8F5</Color>
    <Color x:Key="Color.AccentBloom">#308EB9E8</Color>
    <Color x:Key="Color.AccentBloomSoft">#0C8EB9E8</Color>
    <Color x:Key="Color.AccentClear">#008EB9E8</Color>

    <!-- The window, the title bar and the sidebar. -->
    <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}" />
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#121418" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#F0181B1F" />

    <!-- Boxes, dialogs, fields, buttons and lines. -->
    <SolidColorBrush x:Key="Brush.Panel" Color="#E62A2E32" />
    <SolidColorBrush x:Key="Brush.PanelSolid" Color="#2A2E32" />
    <SolidColorBrush x:Key="Brush.PanelRaised" Color="#35393E" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#14EEF0F3" />
    <SolidColorBrush x:Key="Brush.Field" Color="#1C1F22" />
    <SolidColorBrush x:Key="Brush.ButtonFill" Color="#E61C1F22" />
    <SolidColorBrush x:Key="Brush.Line" Color="#3C4045" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="#565B62" />

    <!-- Veils over the window. -->
    <SolidColorBrush x:Key="Brush.Overlay" Color="#D90E1114" />
    <SolidColorBrush x:Key="Brush.InkVeil" Color="#E01F2225" />
    <SolidColorBrush x:Key="Brush.Busy" Color="#B00E1114" />
    <SolidColorBrush x:Key="Brush.BlurVeil" Color="#800E1114" />

    <!-- Text. -->
    <SolidColorBrush x:Key="Brush.Text" Color="#EEF0F3" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#BEC5CE" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#979FAA" />
    <SolidColorBrush x:Key="Brush.TextMutedWash" Color="#14BEC5CE" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#161B22" />

    <!-- The accent. -->
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentBright" Color="{StaticResource Color.AccentBright}" />
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="#334965" />
    <SolidColorBrush x:Key="Brush.AccentWash" Color="#268EB9E8" />
    <LinearGradientBrush x:Key="Brush.Stroke" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E08EB9E8" Offset="0" />
        <GradientStop Color="#008EB9E8" Offset="1" />
    </LinearGradientBrush>

    <!-- The settings editor; each colour readable on Brush.Field. -->
    <Color x:Key="Color.Syntax.Comment">#9AA2AD</Color>
    <Color x:Key="Color.Syntax.Key">#BAD8F5</Color>
    <Color x:Key="Color.Syntax.String">#E4C7AA</Color>
    <Color x:Key="Color.Syntax.Value">#D2BEED</Color>
    <SolidColorBrush x:Key="Brush.Selection" Color="#558EB9E8" />

    <!-- The shared blue boxes (the recommended mod, mods beside the game's files), at the lightness of
         the panels here. -->
    <SolidColorBrush x:Key="Brush.InfoPanel" Color="#E6283546" />
    <SolidColorBrush x:Key="Brush.GameFilesRow" Color="#E6242F3E" />

</ResourceDictionary>
