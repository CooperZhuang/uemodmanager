<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- WUCHANG: Fallen Feathers, "Feather gold": a faintly violet night ink, warm ivory text and the pale gold of
         Wuchang's shoulder feathers. A light accent: text on it is dark (Brush.OnAccent).
         This file holds every key of Theme\Palette.xaml that a game can change. A key that is left out keeps the
         shared value. A brush here must name its colour again: the brushes of Palette.xaml keep that file's colours. -->
    <Color x:Key="Color.Ink">#0B0A10</Color>
    <Color x:Key="Color.InkClear">#000B0A10</Color>
    <Color x:Key="Color.Accent">#D6B681</Color>
    <Color x:Key="Color.AccentBright">#F1D6AA</Color>
    <Color x:Key="Color.AccentBloom">#30D6B681</Color>
    <Color x:Key="Color.AccentBloomSoft">#0CD6B681</Color>
    <Color x:Key="Color.AccentClear">#00D6B681</Color>

    <!-- The window, the title bar and the sidebar. -->
    <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}" />
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#07060B" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#E00D0D13" />

    <!-- Boxes, dialogs, fields, buttons and lines. -->
    <SolidColorBrush x:Key="Brush.Panel" Color="#E61A1921" />
    <SolidColorBrush x:Key="Brush.PanelSolid" Color="#1A1921" />
    <SolidColorBrush x:Key="Brush.PanelRaised" Color="#27252F" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#14EEE7DD" />
    <SolidColorBrush x:Key="Brush.Field" Color="#100F16" />
    <SolidColorBrush x:Key="Brush.ButtonFill" Color="#D9100F16" />
    <SolidColorBrush x:Key="Brush.Line" Color="#36323E" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="#514A59" />

    <!-- Veils over the window. -->
    <SolidColorBrush x:Key="Brush.Overlay" Color="#D907060B" />
    <SolidColorBrush x:Key="Brush.InkVeil" Color="#E00B0A10" />
    <SolidColorBrush x:Key="Brush.Busy" Color="#B007060B" />
    <SolidColorBrush x:Key="Brush.BlurVeil" Color="#8C07060B" />

    <!-- Text. -->
    <SolidColorBrush x:Key="Brush.Text" Color="#EEE7DD" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#BAB1B5" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#958A94" />
    <SolidColorBrush x:Key="Brush.TextMutedWash" Color="#0FBAB1B5" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#19141A" />

    <!-- The accent. -->
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentBright" Color="{StaticResource Color.AccentBright}" />
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="#695036" />
    <SolidColorBrush x:Key="Brush.AccentWash" Color="#26D6B681" />
    <LinearGradientBrush x:Key="Brush.Stroke" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E0D6B681" Offset="0" />
        <GradientStop Color="#00D6B681" Offset="1" />
    </LinearGradientBrush>

    <!-- The settings editor: gold keys, lavender text, rose values; each readable on Brush.Field (6:1 or more). -->
    <Color x:Key="Color.Syntax.Comment">#998E9B</Color>
    <Color x:Key="Color.Syntax.Key">#F1D6AA</Color>
    <Color x:Key="Color.Syntax.String">#C5BEDF</Color>
    <Color x:Key="Color.Syntax.Value">#DDA4AC</Color>
    <SolidColorBrush x:Key="Brush.Selection" Color="#66D6B681" />

</ResourceDictionary>
