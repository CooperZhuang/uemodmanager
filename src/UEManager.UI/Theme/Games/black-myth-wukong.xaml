<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Black Myth: Wukong, "Ink and seal" (水墨): ink-wash grey, rice-paper text and a cinnabar seal red, after the
         brush calligraphy and red seal of the game's logo. Chosen on 2026-11-11 in place of the first olive look. The
         seal red is more orange than the crimson of Phantom Blade Zero. The accent is dark, so text on it is light.
         background.jpg has its dark field tinted to this ink. A key that is left out keeps the shared value. A brush
         here must name its colour again: the brushes of Palette.xaml keep that file's colours. -->
    <Color x:Key="Color.Ink">#101113</Color>
    <Color x:Key="Color.InkClear">#00101113</Color>
    <Color x:Key="Color.Accent">#B9482F</Color>
    <Color x:Key="Color.AccentBright">#E27C62</Color>
    <Color x:Key="Color.AccentBloom">#30B9482F</Color>
    <Color x:Key="Color.AccentBloomSoft">#0CB9482F</Color>
    <Color x:Key="Color.AccentClear">#00B9482F</Color>

    <!-- The window, the title bar and the sidebar. -->
    <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}" />
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#090B0C" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#E00D0F10" />

    <!-- Boxes, dialogs, fields, buttons and lines. -->
    <SolidColorBrush x:Key="Brush.Panel" Color="#E61A1C1E" />
    <SolidColorBrush x:Key="Brush.PanelSolid" Color="#1A1C1E" />
    <SolidColorBrush x:Key="Brush.PanelRaised" Color="#26282B" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#14EBE7DF" />
    <SolidColorBrush x:Key="Brush.Field" Color="#0D0F10" />
    <SolidColorBrush x:Key="Brush.ButtonFill" Color="#D90D0F10" />
    <SolidColorBrush x:Key="Brush.Line" Color="#333538" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="#4F5256" />

    <!-- Veils over the window. -->
    <SolidColorBrush x:Key="Brush.Overlay" Color="#D9090B0C" />
    <SolidColorBrush x:Key="Brush.InkVeil" Color="#E0101113" />
    <SolidColorBrush x:Key="Brush.Busy" Color="#B0090B0C" />
    <SolidColorBrush x:Key="Brush.BlurVeil" Color="#8C090B0C" />

    <!-- Text. -->
    <SolidColorBrush x:Key="Brush.Text" Color="#EBE7DF" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#B8B5AF" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#928F89" />
    <SolidColorBrush x:Key="Brush.TextMutedWash" Color="#0FB8B5AF" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FCF5F0" />

    <!-- The accent. -->
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentBright" Color="{StaticResource Color.AccentBright}" />
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="#592214" />
    <SolidColorBrush x:Key="Brush.AccentWash" Color="#26B9482F" />
    <LinearGradientBrush x:Key="Brush.Stroke" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E0B9482F" Offset="0" />
        <GradientStop Color="#00B9482F" Offset="1" />
    </LinearGradientBrush>

    <!-- The settings editor; each colour readable on Brush.Field. -->
    <Color x:Key="Color.Syntax.Comment">#9B9893</Color>
    <Color x:Key="Color.Syntax.Key">#E8846B</Color>
    <Color x:Key="Color.Syntax.String">#E3DDD0</Color>
    <Color x:Key="Color.Syntax.Value">#D8BD8D</Color>
    <SolidColorBrush x:Key="Brush.Selection" Color="#70B9482F" />

</ResourceDictionary>
