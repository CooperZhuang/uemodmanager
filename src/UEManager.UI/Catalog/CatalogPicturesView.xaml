<UserControl x:Class="UEManager.UI.Catalog.CatalogPicturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.Catalog"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CatalogViewModel}"
             Focusable="True" FocusVisualStyle="{x:Null}"
             Visibility="{Binding Pictures, Converter={StaticResource VisibleIfSet}}">
    <!-- The keys work while the viewer has the focus: it takes it when it opens. Its buttons do not take it. -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Pictures.CloseCommand}" />
        <KeyBinding Key="Left" Command="{Binding Pictures.PreviousCommand}" />
        <KeyBinding Key="Right" Command="{Binding Pictures.NextCommand}" />
    </UserControl.InputBindings>

    <!-- A mod's cover and screenshots over the whole window, one at a time, as an image viewer shows them. -->
    <Grid Background="{StaticResource Brush.Ink}" DataContext="{Binding Pictures}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="36,22,36,0">
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Focusable="False" Content="{ui:Loc 'Close'}" ui:Icon.Glyph="&#xE711;"
                    Command="{Binding CloseCommand}" ToolTip="Esc" />
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Title}" FontSize="22" TextTrimming="CharacterEllipsis"
                       Text="{Binding Name}" />
        </DockPanel>

        <!-- The picture, as large as fits, never larger than it is; the arrows at its sides. -->
        <Grid Grid.Row="1" Margin="36,18,36,0">
            <Image Margin="64,0" Source="{Binding Current.Image}" Stretch="Uniform" StretchDirection="DownOnly"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Body}"
                       Foreground="{StaticResource Brush.TextDim}" Text="{ui:Loc 'Loading the image…'}"
                       Visibility="{Binding Current.IsLoading, Converter={StaticResource Visible}}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Current.Failed, Converter={StaticResource Visible}}">
                <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource Font.Icons}" FontSize="40"
                           Foreground="{StaticResource Brush.TextDim}" Text="&#xE8B9;" />
                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.TextMuted}" Text="{ui:Loc 'The image could not be loaded.'}" />
            </StackPanel>
            <Button HorizontalAlignment="Left" VerticalAlignment="Center" Width="44" Height="44" Focusable="False"
                    Style="{StaticResource Button.Icon}" Background="{StaticResource Brush.ButtonFill}" BorderBrush="{StaticResource Brush.Line}"
                    FontFamily="{StaticResource Font.Icons}" FontSize="16" Content="&#xE76B;"
                    Command="{Binding PreviousCommand}" ToolTip="{ui:Loc 'Previous image'}"
                    Visibility="{Binding HasMany, Converter={StaticResource Visible}}" />
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="44" Height="44" Focusable="False"
                    Style="{StaticResource Button.Icon}" Background="{StaticResource Brush.ButtonFill}" BorderBrush="{StaticResource Brush.Line}"
                    FontFamily="{StaticResource Font.Icons}" FontSize="16" Content="&#xE76C;"
                    Command="{Binding NextCommand}" ToolTip="{ui:Loc 'Next image'}"
                    Visibility="{Binding HasMany, Converter={StaticResource Visible}}" />
        </Grid>

        <!-- The alt text from the mod's openmods.md, and "2 / 5". -->
        <StackPanel Grid.Row="2" Margin="36,12,36,20" HorizontalAlignment="Center">
            <!-- Always one line, empty without an alt text, so the picture and the arrows never move (the user's wish);
                 a longer text ends in "…" and shows whole as a tooltip. -->
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="900" Text="{Binding Current.Alt}"
                       ToolTip="{Binding Current.Alt}" ToolTipService.IsEnabled="{Binding Current.HasAlt}" />
            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}"
                       Text="{Binding CounterText}" Visibility="{Binding HasMany, Converter={StaticResource Visible}}" />
        </StackPanel>

        <!-- The thumbnails: a click shows the picture; the shown one has the accent's frame and is scrolled into view.
             With many screenshots the strip scrolls, by the mouse wheel too. -->
        <ScrollViewer Grid.Row="3" Margin="36,0,36,20" HorizontalAlignment="Center" Focusable="False"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="Strip_PreviewMouseWheel"
                      Visibility="{Binding HasMany, Converter={StaticResource Visible}}">
            <ItemsControl Focusable="False" ItemsSource="{Binding Pictures}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CatalogPictureViewModel}">
                        <Button Margin="4,0,4,4" Focusable="False" Cursor="Hand" vm:CatalogPicturesView.Shown="{Binding IsCurrent}"
                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" ToolTip="{Binding Alt}" ToolTipService.IsEnabled="{Binding HasAlt}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Frame" Width="112" Height="63" BorderThickness="2" CornerRadius="2"
                                            BorderBrush="{StaticResource Brush.Line}" Background="{StaticResource Brush.Field}" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Font.Icons}"
                                                       FontSize="16" Foreground="{StaticResource Brush.TextDim}" Text="&#xE8B9;"
                                                       Visibility="{Binding ThumbnailFailed, Converter={StaticResource Visible}}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Brush.LineStrong}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
