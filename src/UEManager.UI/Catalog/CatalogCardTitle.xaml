<UserControl x:Class="UEManager.UI.Catalog.CatalogCardTitle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.Catalog"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CatalogItemViewModel}">
    <!-- A card's title line: the type in front of the name, from the paths in the zip, in the Mods page's words; none while
         it is not known. Within a list that sets Grid.IsSharedSizeScope, every type box is as wide as the widest, so all
         names start at the same place, also on cards without a type. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="CatalogType" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Margin="0,0,10,0" HorizontalAlignment="Stretch" Style="{StaticResource Badge}" Background="{StaticResource Brush.InfoPanel}"
                BorderBrush="{StaticResource Brush.Info}" ToolTip="{ui:Loc 'The type of the mod, from the files in its download'}"
                Visibility="{Binding KindText, Converter={StaticResource VisibleIfSet}}">
            <TextBlock HorizontalAlignment="Center" FontFamily="{DynamicResource Font.Label}" FontSize="11"
                       Foreground="{StaticResource Brush.Info}" Text="{Binding KindText}" />
        </Border>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Title}" FontSize="17"
                   TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip="{Binding Name}" />
    </Grid>
</UserControl>
