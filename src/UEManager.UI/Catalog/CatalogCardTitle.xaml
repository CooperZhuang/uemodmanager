<UserControl x:Class="UEManager.UI.Catalog.CatalogCardTitle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UEManager.UI.Catalog"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CatalogItemViewModel}">
    <!-- A card's title line on the openmods page: the type in front of the name. Within a list that sets
         Grid.IsSharedSizeScope, every type box is as wide as the widest, so all names start at the same place, also on
         cards without a type. The full view's narrow cards put the type below the name instead. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="CatalogType" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <vm:CatalogTypeBadge Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Title}" FontSize="17"
                   TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip="{Binding Name}" />
    </Grid>
</UserControl>
