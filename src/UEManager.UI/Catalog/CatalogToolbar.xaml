<UserControl x:Class="UEManager.UI.Catalog.CatalogToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.Catalog"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CatalogViewModel}">
    <!-- The search, the sort, the Mods | Tools switch, the count and Refresh: one row for the openmods page and its full view. -->
    <DockPanel>
        <!-- At the end of the row, as on the Mods page. -->
        <Button DockPanel.Dock="Right" Margin="10,0,0,0" Content="{ui:Loc 'Refresh'}" ui:Icon.Glyph="&#xE72C;" Command="{Binding ReloadCommand}" />
        <!-- A field like the search box, so the sort buttons and the count stay readable over the cover art. -->
        <Border DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource FieldBox}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button VerticalAlignment="Center" Style="{StaticResource Button.SortHeader}"
                        Content="{ui:Loc 'Name', Tracked=True}" Tag="{Binding NameSortGlyph}" ToolTip="{ui:Loc 'Sort by name'}"
                        Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:CatalogSortField.Name}" />
                <Button Margin="18,0,0,0" VerticalAlignment="Center" Style="{StaticResource Button.SortHeader}"
                        Content="{ui:Loc 'Updated', Tracked=True}" Tag="{Binding UpdatedSortGlyph}" ToolTip="{ui:Loc 'Sort by the date of the latest release'}"
                        Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:CatalogSortField.Updated}" />
                <!-- The mods or the tools, such as UE4SS and this app; the page opens on the mods at every start. Plain buttons:
                     the view model shows the side on them, and a click runs a command (see Segment). -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasTools, Converter={StaticResource Visible}}">
                    <Rectangle Width="1" Height="16" Margin="16,0" VerticalAlignment="Center" Fill="{StaticResource Brush.LineStrong}" />
                    <Border Padding="2" VerticalAlignment="Center" CornerRadius="3" BorderThickness="1"
                            BorderBrush="{StaticResource Brush.Line}" Background="{StaticResource Brush.Field}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Segment}" Content="{Binding ModsText}" ui:Segment.IsActive="{Binding ShowMods}"
                                    Command="{Binding ShowModsSideCommand}" />
                            <Button Style="{StaticResource Segment}" Content="{Binding ToolsText}" ui:Segment.IsActive="{Binding ShowTools}"
                                    Command="{Binding ShowToolsSideCommand}"
                                    ToolTip="{ui:Loc 'Show the mods tagged as tools, such as UE4SS'}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Rectangle Width="1" Height="16" Margin="16,0" VerticalAlignment="Center" Fill="{StaticResource Brush.LineStrong}" />
                <!-- The hidden text keeps room for the widest count, so the box and the switch stay in place. -->
                <Grid VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Small}" Text="{Binding CountRoomText}" Visibility="Hidden" />
                    <TextBlock Style="{StaticResource Text.Small}" Text="{Binding CountText}" />
                </Grid>
            </StackPanel>
        </Border>
        <TextBox Style="{StaticResource TextBox.Search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Tag="{ui:Loc 'Filter: mod name, author, tag or description'}" />
    </DockPanel>
</UserControl>
