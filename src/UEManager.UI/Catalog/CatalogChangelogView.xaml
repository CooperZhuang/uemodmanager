<UserControl x:Class="UEManager.UI.Catalog.CatalogChangelogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.Catalog"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CatalogViewModel}"
             Focusable="True" FocusVisualStyle="{x:Null}"
             Visibility="{Binding Changelog, Converter={StaticResource VisibleIfSet}}">
    <!-- Esc closes it while it has the focus: it takes it when it opens. -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Changelog.CloseCommand}" />
    </UserControl.InputBindings>

    <!-- A mod's changelog over the whole window: the texts of its newest releases on GitHub, newest first. -->
    <Grid Background="{StaticResource Brush.Overlay}">
        <Border Style="{StaticResource Dialog}" Width="640" Margin="40" DataContext="{Binding Changelog}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Changelog', Tracked=True}" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Title}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"
                               Text="{ui:Loc 'The texts of its newest releases on GitHub.'}" />
                </StackPanel>

                <DockPanel DockPanel.Dock="Bottom" Margin="0,20,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Focusable="False"
                            Content="{ui:Loc 'Close'}" Command="{Binding CloseCommand}" />
                    <Button DockPanel.Dock="Right" Focusable="False" Content="{ui:Loc 'All releases on GitHub'}" ui:Icon.Glyph="&#xE8A7;"
                            Command="{Binding OpenAllReleasesCommand}" ToolTip="{ui:Loc 'Every release with its full notes'}" />
                </DockPanel>

                <Border Margin="0,14,0,0" MaxHeight="460" Padding="16,6,16,12" CornerRadius="2" BorderThickness="1"
                        Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Line}">
                    <Grid>
                        <!-- Loading, failed or empty: one line, and Try again when GitHub did not answer. -->
                        <TextBlock Margin="0,10,0,4" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextDim}"
                                   Text="{ui:Loc 'Loading the changelog from GitHub…'}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />
                        <StackPanel Margin="0,10,0,4" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}" Text="{Binding Error}" />
                            <Button Margin="0,10,0,0" HorizontalAlignment="Left" Focusable="False" Content="{ui:Loc 'Try again'}" ui:Icon.Glyph="&#xE72C;"
                                    Command="{Binding RetryCommand}" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,4" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextDim}"
                                   Text="{ui:Loc 'This mod has no releases on GitHub yet.'}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Releases}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CatalogReleaseViewModel}">
                                        <StackPanel Margin="0,12,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Text="{Binding Version}" />
                                                <TextBlock Margin="10,0,0,1" VerticalAlignment="Bottom" Style="{StaticResource Text.Small}"
                                                           Foreground="{StaticResource Brush.TextDim}" Text="{Binding DateText}" />
                                                <Border Margin="10,0,0,0" VerticalAlignment="Center" Padding="6,1" CornerRadius="2" BorderThickness="1"
                                                        BorderBrush="{StaticResource Brush.Warning}"
                                                        Visibility="{Binding IsPreRelease, Converter={StaticResource Visible}}">
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Warning}"
                                                               Text="{ui:Loc 'Pre-release'}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,4,0,0" FontSize="12.5" FontStyle="Italic" Foreground="{StaticResource Brush.TextDim}"
                                                       Text="{ui:Loc 'No notes for this release.'}"
                                                       Visibility="{Binding HasNoText, Converter={StaticResource Visible}}" />
                                            <ItemsControl ItemsSource="{Binding Blocks}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CatalogNoteBlockViewModel}">
                                                        <Grid Margin="{Binding Margin}">
                                                            <TextBlock FontSize="{Binding FontSize}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource Brush.Text}" Text="{Binding Text}"
                                                                       Visibility="{Binding IsHeading, Converter={StaticResource Visible}}" />
                                                            <DockPanel Visibility="{Binding IsBullet, Converter={StaticResource Visible}}">
                                                                <TextBlock DockPanel.Dock="Left" MinWidth="14" Margin="0,0,6,0" FontSize="12.5"
                                                                           Foreground="{StaticResource Brush.TextDim}" Text="{Binding Marker}" />
                                                                <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Text}" />
                                                            </DockPanel>
                                                            <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Text}"
                                                                       Visibility="{Binding IsParagraph, Converter={StaticResource Visible}}" />
                                                            <Border Padding="10,6" CornerRadius="2" Background="{StaticResource Brush.PanelSolid}"
                                                                    Visibility="{Binding IsCode, Converter={StaticResource Visible}}">
                                                                <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                                                           Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Text}" />
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
