<UserControl x:Class="UEManager.UI.Catalog.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.Catalog"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CatalogViewModel}">
    <StackPanel>

        <!-- Header -->
        <Grid Margin="0,6,0,0">
            <StackPanel>
                <!-- The site's button keeps a column of its own beside the title, so a long title row (a large interface
                     scale, see Settings) wraps instead of running into it. -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top" Style="{StaticResource Button.OpenMods}"
                            Content="{Binding SiteText}" ui:Icon.Glyph="&#xE8A7;" Command="{Binding OpenSiteCommand}" ToolTip="{ui:Loc 'Open openmods'}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Discover', Tracked=True}" />
                        <!-- The title, and right after it, as big as the line allows, what openmods is, over the whole window;
                             below the title when the line is too short for both. -->
                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Margin="0,0,24,6" VerticalAlignment="Center" Style="{StaticResource Text.Display}" Text="openmods" />
                            <Button Margin="0,0,0,6" Padding="14,8" VerticalAlignment="Center" Style="{StaticResource Button.StatusBox}" Command="{Binding ShowAboutCommand}"
                                    Foreground="{StaticResource Brush.Info}" BorderBrush="{StaticResource Brush.Info}" Background="{StaticResource Brush.InfoWash}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Icon}" FontSize="15" Text="&#xE946;" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15" Text="{ui:Loc 'ABOUT OPENMODS.NEXUS ECOSYSTEM'}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
                <Rectangle Width="200" Height="2" Margin="0,8,0,14" HorizontalAlignment="Left" Fill="{StaticResource Brush.Stroke}" />
                <!-- What the type boxes mean, over the whole window, the full view, and the type filter in the room left. -->
                <DockPanel>
                    <Button DockPanel.Dock="Left" Padding="10,5" VerticalAlignment="Center" Style="{StaticResource Button.StatusBox}" Command="{Binding ShowTypesInfoCommand}"
                            Foreground="{StaticResource Brush.Info}" BorderBrush="{StaticResource Brush.Info}" Background="{StaticResource Brush.InfoWash}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="&#xE946;" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{ui:Loc 'MOD TYPE INFO'}" />
                        </StackPanel>
                    </Button>
                    <!-- The full view, in the same row and as high as the boxes, outlined in orange to catch the eye. -->
                    <Button DockPanel.Dock="Left" Margin="16,0,0,0" Padding="10,5" VerticalAlignment="Center" FontSize="12"
                            Style="{StaticResource Button.FullView}" Content="{ui:Loc 'Full view'}"
                            ui:Icon.Glyph="&#xE740;" Command="{Binding EnterFullViewCommand}"
                            ToolTip="{ui:Loc 'Show openmods over the whole window, as a grid of cards'}" />
                    <vm:CatalogTypeFilter Margin="28,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Grid>

        <!-- Test catalog from the command line -->
        <Border Margin="0,22,0,0" Padding="14,10" HorizontalAlignment="Left" CornerRadius="2" BorderThickness="1"
                Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Warning}"
                Visibility="{Binding TestCatalogText, Converter={StaticResource VisibleIfSet}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top" Style="{StaticResource Text.Icon}"
                           FontSize="13" Foreground="{StaticResource Brush.Warning}" Text="&#xE7BA;" />
                <TextBlock TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource Brush.Warning}" Text="{Binding TestCatalogText}" />
            </DockPanel>
        </Border>

        <!-- Not loaded -->
        <Border Margin="0,22,0,0" Style="{StaticResource Card}" BorderBrush="{StaticResource Brush.AccentDeep}"
                Visibility="{Binding Error, Converter={StaticResource VisibleIfSet}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="20,0,0,0" VerticalAlignment="Center" Content="{ui:Loc 'Try again'}"
                        ui:Icon.Glyph="&#xE72C;" Command="{Binding ReloadCommand}" />
                <TextBlock DockPanel.Dock="Left" Margin="0,0,16,0" Style="{StaticResource Text.Icon}" FontSize="18"
                           Foreground="{StaticResource Brush.Accent}" Text="&#xE7BA;" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{ui:Loc 'The openmods list is not available right now'}" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap" TextTrimming="None" Text="{Binding Error}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Margin="0,52" HorizontalAlignment="Center" Style="{StaticResource Text.Body}" Text="{ui:Loc 'Loading the openmods list…'}"
                   Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />

        <!-- Search and sort: shared with the full view. -->
        <vm:CatalogToolbar Margin="0,26,0,0" Visibility="{Binding HasItems, Converter={StaticResource Visible}}" />

        <!-- Nothing here matches the search, or this side of the switch is empty: shared with the full view. -->
        <vm:CatalogNoMatch />

        <!-- Nothing listed for this game -->
        <StackPanel Margin="0,52" HorizontalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource Visible}}">
            <ContentControl Style="{StaticResource BrandMark}" Width="40" Height="40" Opacity="0.5" />
            <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Title}" Text="{Binding EmptyText}" />
            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Body}"
                       Text="{ui:Loc 'New mods show up here as soon as openmods lists them.'}" />
            <!-- The row with the other Refresh shows only with mods listed. -->
            <Button Margin="0,14,0,0" HorizontalAlignment="Center" Content="{ui:Loc 'Refresh'}" ui:Icon.Glyph="&#xE72C;" Command="{Binding ReloadCommand}" />
        </StackPanel>

        <!-- Mods -->
        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding ItemsView}" Focusable="False" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CatalogItemViewModel}">
                    <Border Margin="0,0,0,12" Style="{StaticResource Card}" Padding="0">
                        <!-- Cover, text and buttons side by side; a narrow card (a large interface scale, see Settings)
                             puts the buttons below the text, so the text keeps room to read. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Cover: 16:9 at least, and always the full height of the card (cropped when the card is
                                 taller). As high as a card with a two-line description, so the cover does not make
                                 the card taller. The game's picture when the mod has none. -->
                            <Border Grid.RowSpan="2" Width="216" MinHeight="122" Margin="1" ClipToBounds="True" Background="{StaticResource Brush.Field}">
                                <!-- A click opens the picture viewer, when the mod has its own cover or screenshots. -->
                                <Button Style="{StaticResource Button.Cover}" IsEnabled="{Binding HasPictures}"
                                        Command="{Binding DataContext.ShowPicturesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="{ui:Loc 'Show the images'}">
                                    <Grid>
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <!-- The image icon and the number, bottom left: the cover opens the viewer (the user's wish: a hint to click). -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="6,2,7,3" CornerRadius="2"
                                                Background="{StaticResource Brush.Overlay}" BorderBrush="{StaticResource Brush.LineStrong}" BorderThickness="1"
                                                Visibility="{Binding HasPictures, Converter={StaticResource Visible}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{StaticResource Brush.Text}" Text="&#xE8B9;" />
                                                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Text}" Text="{Binding PictureCount}">
                                                    <!-- The digits are 2 px lower than the icon is high: 1 px up centers them on it. -->
                                                    <TextBlock.RenderTransform>
                                                        <TranslateTransform Y="-1" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Button>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="22,14,16,14">
                                <!-- The type in front of the name, as in the full view. -->
                                <vm:CatalogCardTitle />
                                <TextBlock Margin="0,6,0,0" FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Summary}"
                                           Visibility="{Binding Summary, Converter={StaticResource VisibleIfSet}}" />
                                <!-- The tags, then the version, date and license on a line of their own, as in the full view. -->
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Tags}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,0" Style="{StaticResource Badge}">
                                                <TextBlock FontFamily="{DynamicResource Font.Label}" FontSize="11" Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <vm:CatalogMetaLine Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- As wide as Page, Source and Changelog with their words; below the text on a narrow card. -->
                            <StackPanel Width="264">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Grid.Column" Value="2" />
                                        <Setter Property="Margin" Value="0,14,22,14" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource NarrowCard}}"
                                                         Value="True">
                                                <Setter Property="Grid.Column" Value="1" />
                                                <Setter Property="Grid.Row" Value="1" />
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Margin" Value="22,0,16,16" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Style="{StaticResource Button.Primary}" Content="{Binding ActionText}" ui:Icon.Glyph="&#xE896;"
                                        Command="{Binding ActCommand}" Visibility="{Binding HasAction, Converter={StaticResource Visible}}" />
                                <StackPanel Margin="0,6,0,0" HorizontalAlignment="Center" Orientation="Horizontal"
                                            Visibility="{Binding StatusText, Converter={StaticResource VisibleIfSet}}">
                                    <TextBlock Margin="0,0,6,0" Style="{StaticResource Text.Icon}" FontSize="12"
                                               Foreground="{Binding StatusTone, Converter={StaticResource Tone}}" Text="{Binding StatusGlyph}" />
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               Foreground="{Binding StatusTone, Converter={StaticResource Tone}}" Text="{Binding StatusText}" />
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Button Padding="8,3" FontSize="12" Content="{ui:Loc 'Page'}" ui:Icon.Glyph="&#xE774;" Command="{Binding OpenPageCommand}"
                                            Visibility="{Binding HasPage, Converter={StaticResource Visible}}"
                                            ToolTip="{ui:Loc 'The mod\'s page on openmods, with its full description'}" />
                                    <Button Margin="6,0,0,0" Padding="8,3" FontSize="12" Content="{ui:Loc 'Source'}" ui:Icon.Glyph="&#xE943;"
                                            Command="{Binding OpenSourceCommand}" Visibility="{Binding HasSource, Converter={StaticResource Visible}}"
                                            ToolTip="{Binding Mod.Source}" />
                                    <!-- The texts of the mod's newest releases on GitHub, read on the click. -->
                                    <Button Margin="6,0,0,0" Padding="8,3" FontSize="12" Content="{ui:Loc 'Changelog'}" ui:Icon.Glyph="&#xE8FD;"
                                            Command="{Binding DataContext.ShowChangelogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Visibility="{Binding HasChangelog, Converter={StaticResource Visible}}"
                                            ToolTip="{ui:Loc 'What changed in each version, from the mod\'s releases on GitHub'}" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Small}"
                                           Text="{Binding AuthorText}" ToolTip="{Binding AuthorText}" />
                                <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Small}"
                                           Text="{Binding ListedByText}" ToolTip="{Binding ListedByText}"
                                           Visibility="{Binding ListedByText, Converter={StaticResource VisibleIfSet}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
