<UserControl x:Class="UEManager.UI.Catalog.CatalogTypeFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.Catalog"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CatalogViewModel}"
             Visibility="{Binding HasTypeChoices, Converter={StaticResource Visible}}">
    <!-- The type filter of the openmods page and its full view: All, then each type of the open side with its number of
         cards; one at a time. The active button is blue like the type boxes. Plain buttons, as in the Mods | Tools switch:
         the view model marks the shown type, and a click runs a command. Too many types for the room left wrap inside the
         box: the dock panel gives the box that room, where a horizontal stack panel would give it no limit. -->
    <DockPanel>
        <TextBlock DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource Text.Overline}"
                   Text="{ui:Loc 'Type', Tracked=True}" />
        <Border Padding="2" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="3" BorderThickness="1"
                BorderBrush="{StaticResource Brush.Line}" Background="{StaticResource Brush.Field}"
                ToolTip="{ui:Loc 'Show the mods of one type'}">
            <ItemsControl ItemsSource="{Binding TypeChoices}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CatalogTypeChoice}">
                        <Button Style="{StaticResource Segment}" Content="{Binding Text}" ui:Segment.IsActive="{Binding IsActive}"
                                Command="{Binding SelectCommand}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DockPanel>
</UserControl>
